<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/swara_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:id="@+id/widget_text_col"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="NOW PLAYING"
                android:textColor="#93C5FD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Swara Music"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to open player"
                android:textColor="#AAFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_repeat"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Repeat"
            android:padding="7dp"
            android:src="@drawable/ic_widget_repeat" />

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Previous"
            android:padding="6dp"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/swara_widget_play_bg"
            android:contentDescription="Play or Pause"
            android:padding="10dp"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Next"
            android:padding="6dp"
            android:src="@drawable/ic_widget_next" />

        <ImageButton
            android:id="@+id/widget_shuffle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="Shuffle"
            android:padding="7dp"
            android:src="@drawable/ic_widget_shuffle" />
    </LinearLayout>

</LinearLayout>
