<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:id="@+id/widget_text_col"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Swara Music"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tap for widget settings"
                    android:textColor="#BBFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_repeat"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Repeat"
                android:padding="6dp"
                android:src="@drawable/ic_widget_repeat" />

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Previous"
                android:padding="6dp"
                android:src="@drawable/ic_widget_prev" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/swara_widget_play_bg"
                android:contentDescription="Play or Pause"
                android:padding="9dp"
                android:src="@drawable/ic_widget_play" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Next"
                android:padding="6dp"
                android:src="@drawable/ic_widget_next" />

            <ImageButton
                android:id="@+id/widget_shuffle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:contentDescription="Shuffle"
                android:padding="6dp"
                android:src="@drawable/ic_widget_shuffle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#BBFFFFFF"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#44FFFFFF" />

            <TextView
                android:id="@+id/widget_time_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#BBFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
